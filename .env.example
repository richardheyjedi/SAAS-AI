NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
# Provedor dos textos (personas/roteiros): "muapi" usa o gpt-5 da MuAPI (mesma conta dos vídeos);
# qualquer outro valor (ou vazio) usa a Anthropic acima.
TEXT_PROVIDER=muapi
# Modelo de texto da MuAPI (default gpt-5-mini)
# MUAPI_TEXT_MODEL=gpt-5-mini
MUAPI_API_KEY=...
MUAPI_BASE_URL=https://api.muapi.ai
APP_BASE_URL=http://localhost:3000
MUAPI_WEBHOOK_SECRET=troque-por-um-segredo
CRON_SECRET=troque-por-um-segredo
# E-mails autorizados a usar o painel (separados por vírgula). Vazio = qualquer conta autenticada.
ALLOWED_EMAILS=voce@exemplo.com
DAILY_VIDEO_LIMIT=40
